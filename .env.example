# Register at https://cpanel.egwwritings.org/applications/create
CLIENT_ID=
CLIENT_SECRET=

# Optional overrides
# EGW_FOLDERS=Books,Devotionals
# EGW_DOWNLOAD_CONCURRENCY=3
# EGW_REQUEST_DELAY_MS=300

# Cloudflare R2 — hosts the prebuilt corpus artifacts (npm run corpus:upload).
# Only needed when publishing a rebuilt corpus, not for local development.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Set in Vercel (not here) to the bucket's public URL, e.g.
# https://pub-xxxx.r2.dev — omit locally to serve from public/corpus.
# VITE_CORPUS_BASE_URL=
