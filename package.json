{
  "name": "ellen_white_app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "corpus:build:egw": "tsx scripts/build-corpus.ts",
    "corpus:build:pioneers": "tsx scripts/build-pioneers-corpus.ts",
    "corpus:build:pioneer": "npm run corpus:build:pioneers",
    "corpus:build": "tsx scripts/build-corpus.ts && tsx scripts/build-pioneers-corpus.ts && npm run corpus:optimize",
    "corpus:optimize": "tsx scripts/optimize-corpus.ts public/corpus/egw.sqlite public/corpus/egw.v5.sqlite && tsx scripts/optimize-corpus.ts public/corpus/pioneers.sqlite public/corpus/pioneers.v5.sqlite",
    "corpus:verify": "tsx scripts/verify-corpus.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@bokuweb/zstd-wasm": "^0.0.27",
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "comlink": "^4.4.2",
    "idb": "^8.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "fflate": "^0.8.3",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.11",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  }
}
